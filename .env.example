# Ambiente local do Hostly. Copie para .env (que o git ignora): cp .env.example .env
# Os valores abaixo são só de desenvolvimento. Em produção, cada um vem do cofre de segredos.

# --- Postgres (container do docker-compose) ---
POSTGRES_USER=hostly
POSTGRES_PASSWORD=hostly_dev
POSTGRES_DB=hostly
# Porta publicada em 127.0.0.1 no host. Se estiver ocupada, troque aqui e no DATABASE_URL.
POSTGRES_PORT=5432
# Conexão no formato que o Prisma usa. Repete os valores acima, porque o dotenv não expande variáveis.
DATABASE_URL=postgresql://hostly:hostly_dev@127.0.0.1:5432/hostly?schema=public

# --- Redis (fila do BullMQ) ---
# Porta publicada em 127.0.0.1 no host
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# --- Storage S3 (SeaweedFS local; em produção, R2 ou S3) ---
# Porta publicada em 127.0.0.1 no host
S3_PORT=8333
# Endpoint da API S3. R2: https://<conta>.r2.cloudflarestorage.com. S3 da AWS: deixar vazio.
S3_ENDPOINT=http://127.0.0.1:8333
# Região. Local e S3: us-east-1 (ou a região do bucket). R2: auto.
S3_REGION=us-east-1
# Bucket da mídia; o serviço storage-init cria na subida
S3_BUCKET=hostly-media
# Chaves de desenvolvimento; o SeaweedFS usa estas como credencial de admin
S3_ACCESS_KEY_ID=hostly-dev
S3_SECRET_ACCESS_KEY=hostly-dev-secret
# Endereço no formato endpoint/bucket/chave. Local precisa de true; R2 aceita; na AWS pode ser false.
S3_FORCE_PATH_STYLE=true
# Origens do painel liberadas no CORS do bucket (upload direto do navegador), separadas por vírgula
S3_CORS_ORIGINS=http://localhost:3000

# --- API (apps/api) ---
NODE_ENV=development
# Porta da API. A 3000 fica com o painel.
API_PORT=3001
# Endereço público da API (também vira iss/aud do JWT)
APP_URL=http://localhost:3001
# Endereço do painel, usado nos links dos e-mails (verificação, reset, convite)
APP_PUBLIC_URL=http://localhost:3000
# Origens liberadas no CORS da API, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
# A API usa host + porta (REDIS_PORT acima); o Redis local não tem senha
REDIS_HOST=127.0.0.1
# Atrás de proxy em produção: número de saltos confiáveis (ex.: 1)
# TRUST_PROXY=1

# JWT (RS256) e chave de criptografia do 2FA. Gere valores de desenvolvimento com:
#   pnpm --filter @hostly/api env:keys
# e cole a saída aqui. Nunca versione chaves reais.
JWT_ACCESS_CURRENT_KID=dev
JWT_ACCESS_PRIVATE_KEY_CURRENT=rode-pnpm-filter-hostly-api-env-keys
JWT_ACCESS_PUBLIC_KEYS={"dev":"rode-pnpm-filter-hostly-api-env-keys"}
JWT_ACCESS_EXPIRES_IN=15m
ENCRYPTION_KEY=rode-pnpm-filter-hostly-api-env-keys

# E-mail: "log" só escreve no log (desenvolvimento); "resend" exige RESEND_API_KEY
EMAIL_PROVIDER=log
EMAIL_FROM=Hostly <noreply@example.com>
# RESEND_API_KEY=

# IPs liberados no /metrics (obrigatório em produção)
METRICS_ALLOWED_IPS=127.0.0.1,::1

# Logs: LOG_LEVEL (fatal|error|warn|info|debug|trace|silent) e LOG_PRETTY=true|false
# LOG_LEVEL=debug
LOG_SLOW_REQUEST_MS=1000
LOG_SLOW_QUERY_MS=100

# Retenção (dias) das limpezas diárias e histórico de senhas
# SESSION_RETENTION_DAYS=30
# AUDIT_RETENTION_DAYS=365
# EPHEMERAL_TOKEN_RETENTION_DAYS=7
# PASSWORD_HISTORY_SIZE=5

# Admin criado pelo seed (pnpm --filter @hostly/api db:seed). Senha só de desenvolvimento.
SUPER_ADMIN_EMAIL=admin@hostly.local
SUPER_ADMIN_PASSWORD=HostlyDev@123
SUPER_ADMIN_NAME=Admin
# Operadora criada pelo seed (nome e slug da Organization). A marca vem daqui, nunca do código.
SEED_OPERATOR_NAME="[SUA EMPRESA]"
SEED_OPERATOR_SLUG=sua-empresa
