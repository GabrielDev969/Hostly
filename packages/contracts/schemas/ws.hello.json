{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ws.hello",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "hello"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "Sender's clock"
    },
    "payload": {
      "type": "object",
      "properties": {
        "serial": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$",
          "description": "Robot serial number, from getRobotSn"
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "romVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "From getVersion"
        },
        "manifestVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ],
          "description": "Version of the last manifest received; null before the first one"
        },
        "contractVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "serial",
        "appVersion",
        "romVersion",
        "manifestVersion",
        "contractVersion"
      ]
    }
  },
  "required": [
    "type",
    "sentAt",
    "payload"
  ]
}
