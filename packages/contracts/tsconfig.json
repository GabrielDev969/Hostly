{
  "extends": "@hostly/config/tsconfig/node.json",
  "compilerOptions": {
    "types": ["node"],
    // Node runs src, tests and scripts with type stripping, so imports use .ts and tsc rewrites them to .js.
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "test", "scripts"]
}
