generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  name         String
  passwordHash String?

  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)
  recoveryCodes    String?

  emailVerifiedAt     DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  tokensInvalidatedAt DateTime?

  ownedOrganizations  Organization[]       @relation("OrganizationOwner")
  ownedWorkspaces     Workspace[]          @relation("WorkspaceOwner")
  memberships         WorkspaceMember[]
  sessions            Session[]
  auditLogs           AuditLog[]
  invitationsSent     Invitation[]         @relation("InvitedBy")
  emailVerifyTokens   EmailVerifyToken[]
  passwordResetTokens PasswordResetToken[]
  passwordHistory     PasswordHistory[]

  deletedAt    DateTime?
  anonymizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([deletedAt])
  @@index([anonymizedAt])
}

model EmailVerifyToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordHistory {
  id           String @id @default(uuid())
  userId       String
  passwordHash String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model Organization {
  id      String @id @default(uuid())
  name    String
  slug    String @unique
  ownerId String
  owner   User   @relation("OrganizationOwner", fields: [ownerId], references: [id])

  workspaces Workspace[]
  auditLogs  AuditLog[]
  clients    Client[]
  sites      Site[]
  robots     Robot[]
  telemetry  TelemetrySnapshot[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerId])
  @@index([deletedAt])
}

model Workspace {
  id             String  @id @default(uuid())
  name           String
  slug           String  @unique
  isPersonal     Boolean @default(false)
  ownerId        String
  organizationId String

  owner        User         @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  members      WorkspaceMember[]
  roles        Role[]
  invitations  Invitation[]
  auditLogs    AuditLog[]
  permissions  Permission[]
  featureFlags WorkspaceFeatureFlag[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerId])
  @@index([organizationId])
  @@index([deletedAt])
}

model WorkspaceMember {
  id           String  @id @default(uuid())
  userId       String
  workspaceId  String
  roleId       String
  // Tenant scope of the membership: null/null = operator; clientId = client user; both = advertiser.
  // The advertiserId foreign key arrives with the Advertiser table.
  clientId     String?
  advertiserId String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Keyed by the workspace too, so a membership can only hold a role of its own workspace.
  role      Role      @relation(fields: [roleId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  joinedAt DateTime @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([roleId, workspaceId])
  @@index([clientId])
  @@index([advertiserId])
}

model Invitation {
  id          String    @id @default(uuid())
  email       String
  workspaceId String
  roleId      String
  invitedById String
  // Client the accepted membership belongs to; null = operator membership.
  clientId    String?
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // NoAction: deleting a role deletes its invitations first (PrismaRolesRepository.delete), in the
  // order accepting locks them, so a race refuses the delete instead of deadlocking.
  role      Role      @relation(fields: [roleId, workspaceId], references: [id, workspaceId], onDelete: NoAction, onUpdate: Restrict)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id])
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([email])
  @@index([clientId])
  @@index([roleId, workspaceId])
}

enum ClientStatus {
  onboarding
  active
  paused
}

model Client {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  status         ClientStatus @default(onboarding)
  // The operator's own robots (fair, demo, event). One per organization, always active, never deleted:
  // enforced by a partial unique index and a CHECK in the migration SQL.
  isInternal     Boolean      @default(false)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sites        Site[]
  members      WorkspaceMember[]
  invitations  Invitation[]
  telemetry    TelemetrySnapshot[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Target of Site's composite foreign key, so a site can never point to another organization's client.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([deletedAt])
}

model Site {
  id             String  @id @default(uuid())
  organizationId String
  clientId       String
  name           String
  // IANA time zone; the robot plays its schedule by it.
  timezone       String
  address        String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  robots       Robot[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Target of Robot's composite foreign key, so a robot's client and organization always match its site.
  @@unique([id, clientId, organizationId])
  @@index([organizationId])
  @@index([clientId])
  @@index([deletedAt])
}

enum RobotModel {
  luckibot_plus
}

enum RobotStatus {
  pending
  active
  revoked
}

// Same values as robotModeSchema in @hostly/contracts; robot-mode.spec.ts fails if they drift.
enum RobotMode {
  idle
  promotion
  cruise
  guide
  reception
  base
  suspended
}

model Robot {
  id              String      @id @default(uuid())
  organizationId  String
  clientId        String
  siteId          String
  // Unique across organizations: a robot belongs to one operator at a time.
  serial          String      @unique
  model           RobotModel  @default(luckibot_plus)
  name            String
  // Reported by the robot once it connects; null until then.
  romVersion      String?
  appVersion      String?
  status          RobotStatus @default(pending)
  // sha256 of the device token. Set only while active: enforced by a CHECK in the migration SQL.
  deviceTokenHash String?     @unique
  // Reported in the hello; null before the first manifest.
  manifestVersion String?

  // Presence: online from the hello until the socket closes or the stale sweep finds lastSeenAt too old.
  online     Boolean   @default(false)
  lastSeenAt DateTime?

  // Last telemetry, kept for good (the history in TelemetrySnapshot is pruned). Battery 0-100 and the pose
  // all-or-nothing: enforced by CHECKs in the migration SQL.
  telemetryAt       DateTime?
  battery           Int?
  charging          Boolean?
  poseX             Float?
  poseY             Float?
  poseTheta         Float?
  mode              RobotMode?
  emergency         Boolean?
  // No foreign key yet: media assets arrive with the advertising pipeline.
  nowPlayingAssetId String?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site                @relation(fields: [siteId, clientId, organizationId], references: [id, clientId, organizationId], onDelete: Restrict)
  pairings     RobotPairing[]
  telemetry    TelemetrySnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Target of TelemetrySnapshot's composite foreign key.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([clientId])
  @@index([siteId])
}

// Short telemetry history. The row keeps the client the robot belonged to when it arrived: moving the robot
// leaves its history behind. Pruned after TELEMETRY_RETENTION_DAYS by the maintenance job.
model TelemetrySnapshot {
  id             String    @id @default(uuid())
  organizationId String
  clientId       String
  robotId        String
  // When the cloud received it: the robot's clock may be off.
  ts             DateTime  @default(now())
  battery        Int?
  charging       Boolean?
  poseX          Float?
  poseY          Float?
  poseTheta      Float?
  mode           RobotMode
  emergency      Boolean

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  // Composite, so a history row can never point to another organization's robot.
  robot        Robot        @relation(fields: [robotId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId])
  @@index([clientId])
  @@index([robotId, ts])
  @@index([ts])
}

enum RobotPairingStatus {
  pending
  approved
}

// A pairing starts before the robot has an owner, so it carries no tenant column; approval links it
// to a Robot. Delivered pairings are deleted and expired ones are cleared on the next start.
model RobotPairing {
  id          String             @id @default(uuid())
  // sha256 of the pairingId handed to the robot, which is its polling secret.
  pollKeyHash String             @unique
  serial      String
  code        String             @unique
  status      RobotPairingStatus @default(pending)
  // Set exactly when approved: enforced by a CHECK in the migration SQL.
  robotId     String?
  expiresAt   DateTime

  robot Robot? @relation(fields: [robotId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([robotId])
}

model Role {
  id          String  @id @default(uuid())
  name        String
  description String?
  workspaceId String
  isSystem    Boolean @default(false)

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     WorkspaceMember[]
  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  // Target of the composite foreign keys of WorkspaceMember and Invitation.
  @@unique([id, workspaceId])
}

model Permission {
  id          String  @id @default(uuid())
  key         String
  description String?
  category    String
  workspaceId String?

  workspace Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roles     RolePermission[]

  // Uniqueness is enforced by partial unique indexes created in migration SQL:
  //   - one row per key when workspaceId IS NULL  (global permissions)
  //   - one row per (workspaceId, key) when workspaceId IS NOT NULL
  @@index([workspaceId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model WorkspaceFeatureFlag {
  id          String  @id @default(uuid())
  workspaceId String
  key         String
  enabled     Boolean

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, key])
  @@index([key])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id             String  @id @default(uuid())
  userId         String?
  workspaceId    String?
  organizationId String?
  clientId       String?
  action         String
  resource       String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?

  prevHash    String?
  hash        String  @unique
  // Only 2 is valid: the hash covers organizationId, clientId, its own version and canonical metadata.
  hashVersion Int     @default(2)

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  // Restrict, not SetNull: a cascade must never rewrite a row that is already hashed into the chain.
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([clientId])
  @@index([action])
  @@index([createdAt])
}
